{
  "schemaVersion": 1,
  "id": "sonar-bypass",
  "version": "${version}",
  "name": "Sonar Bypass",
  "description": "Bypasses Sonar Anti-Bot verification on local test servers.",
  "authors": [
    "Erfan Mirdehghan"
  ],
  "contact": {
    "homepage": "https://github.com/Erfan-Mirdehghan/Meteor-Sonar-Bypass",
    "sources": "https://github.com/Erfan-Mirdehghan/Meteor-Sonar-Bypass"
  },
  "icon": "assets/sonar-bypass/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.erfanmirdehghan.sonarbypass.SonarBypassAddon"
    ]
  },
  "mixins": [
    "sonarbypass.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "0,150,255",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=21",
    "minecraft": ">=1.21.11",
    "meteor-client": "*"
  }
}